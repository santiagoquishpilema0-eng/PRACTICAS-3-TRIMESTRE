void setup() {

  // Encender luz de pantalla
  pinMode(TFT_BL, OUTPUT);
  digitalWrite(TFT_BL, HIGH);

  // Iniciar SPI
  lcdSPI.begin(TFT_SCLK, -1, TFT_MOSI, TFT_CS);

  // Iniciar pantalla
  tft.init(240, 320);

  // Rotación correcta
  tft.setRotation(1);

  // Fondo negro
  tft.fillScreen(ST77XX_BLACK);

  // 🔥 Mostrar imagen 240x240 centrada
tft.drawRGBBitmap(40, 0, epd_bitmap_fds, 240, 240);
}

